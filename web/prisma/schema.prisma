generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                    String           @id @default(uuid())
  email                 String           @unique
  name                  String?
  avatar                String?
  subscriptionTier      SubscriptionTier @default(NONE)
  points                Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  height                Int?
  weight                Int?
  gender                String?
  topSize               String?
  bottomSize            String?
  shoeSize              Int?
  encryptedMeasurements String?
  cartItems             CartItem[]
  orders                Order[]
  wishlist              WishlistItem[]

  @@map("profiles")
}

model Product {
  id            String         @id @default(uuid())
  name          String
  description   String?
  price         Int
  originalPrice Int?
  imageUrl      String         @default("/placeholder.jpg")
  category      String
  isNew         Boolean        @default(false)
  isBest        Boolean        @default(false)
  stock         Int            @default(100)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  @@map("products")
}

model CartItem {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profileId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())
  addedAt   DateTime @default(now())
  profileId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, productId])
  @@map("wishlist_items")
}

model Order {
  id              String      @id @default(uuid())
  totalPrice      Int
  status          OrderStatus @default(PENDING)
  shippingAddress String?
  shippingMemo    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  profileId       String
  orderItems      OrderItem[]
  profile         Profile     @relation(fields: [profileId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  price     Int
  orderId   String
  productId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Subscription {
  id          String             @id @default(uuid())
  profileId   String             @unique
  tier        SubscriptionTier
  billingKey  String?
  startDate   DateTime           @default(now())
  nextBilling DateTime?
  status      SubscriptionStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("subscriptions")
}

model DonationOrg {
  id          String         @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  votes       DonationVote[]

  @@map("donation_orgs")
}

model DonationVote {
  id        String      @id @default(uuid())
  profileId String
  orgId     String
  month     String
  weight    Int         @default(1)
  createdAt DateTime    @default(now())
  org       DonationOrg @relation(fields: [orgId], references: [id])

  @@unique([profileId, month])
  @@map("donation_votes")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model body_measurements {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @unique(map: "unique_user_body_measurement") @db.Uuid
  height     Bytes?
  chest      Bytes?
  waist      Bytes?
  hips       Bytes?
  inseam     Bytes?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model donation_organizations {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @db.VarChar(100)
  description String?
  logo_url    String?
  website     String?   @db.VarChar(200)
  is_active   Boolean?  @default(true)
  vote_count  Int?      @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model points_transactions {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  amount     Int
  type       String    @db.VarChar(20)
  reason     String    @db.VarChar(200)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_points_transactions_created_at")
  @@index([user_id], map: "idx_points_transactions_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ts_alerts {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  alert_type      String    @db.VarChar(50)
  severity        String    @default("medium") @db.VarChar(20)
  title           String    @db.VarChar(200)
  message         String
  reference_type  String?   @db.VarChar(50)
  reference_id    String?   @db.Uuid
  is_sent         Boolean?  @default(false)
  sent_at         DateTime? @db.Timestamptz(6)
  sent_via        Json?     @default("[]")
  send_error      String?
  is_read         Boolean?  @default(false)
  read_at         DateTime? @db.Timestamptz(6)
  is_resolved     Boolean?  @default(false)
  resolved_at     DateTime? @db.Timestamptz(6)
  resolved_by     String?   @db.VarChar(100)
  resolution_note String?
  metadata        Json?     @default("{}")
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_ts_alerts_created")
  @@index([severity], map: "idx_ts_alerts_severity")
  @@index([alert_type], map: "idx_ts_alerts_type")
}

model ts_categories {
  id                     String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  naver_category_id      String?         @unique @db.VarChar(50)
  name                   String          @db.VarChar(200)
  parent_id              String?         @db.Uuid
  depth                  Int?            @default(1)
  is_blocked             Boolean?        @default(false)
  block_reason           String?         @db.VarChar(255)
  requires_certification Boolean?        @default(false)
  certification_types    Json?           @default("[]")
  commission_rate        Decimal?        @default(10) @db.Decimal(5, 2)
  trend_score            Decimal?        @default(0) @db.Decimal(5, 2)
  competition_level      String?         @default("medium") @db.VarChar(20)
  metadata               Json?           @default("{}")
  created_at             DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?       @default(now()) @db.Timestamptz(6)
  ts_categories          ts_categories?  @relation("ts_categoriesTots_categories", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_ts_categories    ts_categories[] @relation("ts_categoriesTots_categories")
  ts_products            ts_products[]
  ts_trend_data          ts_trend_data[]

  @@index([is_blocked], map: "idx_ts_categories_blocked")
  @@index([naver_category_id], map: "idx_ts_categories_naver_id")
  @@index([parent_id], map: "idx_ts_categories_parent")
}

