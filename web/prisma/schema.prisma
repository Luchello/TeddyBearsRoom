model ts_inventory_logs {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  inventory_id   String?       @db.Uuid
  product_id     String?       @db.Uuid
  change_type    String        @db.VarChar(30)
  change_amount  Int
  previous_stock Int?
  new_stock      Int?
  reason         String?       @db.VarChar(200)
  reference_id   String?       @db.VarChar(100)
  created_at     DateTime?     @default(now()) @db.Timestamptz(6)
  ts_inventory   ts_inventory? @relation(fields: [inventory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ts_products    ts_products?  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_ts_inventory_logs_created")
  @@index([inventory_id], map: "idx_ts_inventory_logs_inventory")
  @@index([product_id], map: "idx_ts_inventory_logs_product")
}

