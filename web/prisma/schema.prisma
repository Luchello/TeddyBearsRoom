enum SubscriptionTier {
  NONE
  STANDARD
  PREMIUM
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

// ============================================================
// REFERRAL MILESTONE SYSTEM
// 피추천인(B)의 구독 유지 기간에 따른 추천인(A) 보상
// ============================================================

// 추천 관계 (A가 B를 추천)
model Referral {
  id              String         @id @default(uuid())
  referrerId      String         // 추천인 (A)
  refereeId       String         @unique // 피추천인 (B) - 한 번만 추천받을 수 있음
  referralCode    String         // 사용된 추천 코드

  status          ReferralStatus @default(ACTIVE)

  // 피추천인(B)의 구독 시작일 (마일스톤 계산 기준)
  refereeSubscriptionStartedAt DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  referrer        Profile        @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)
  referee         Profile        @relation("RefereeRelation", fields: [refereeId], references: [id], onDelete: Cascade)
  milestoneRewards ReferralMilestoneReward[]
  milestones      ReferralMilestone[] @relation("ReferralMilestones")

  @@index([referrerId])
  @@index([referralCode])
  @@map("referrals")
}

// 추천 마일스톤 보상 달성 기록
// B의 구독 유지 기간에 따라 A가 받는 보상
model ReferralMilestoneReward {
  id              String   @id @default(uuid())
  referralId      String

  // 마일스톤 정보
  milestoneMonths Int      // 3, 6, 12 (개월)
  rewardPoints    Int      // 3000, 5000, 10000 (포인트)

  // 달성 및 지급 상태
  achievedAt      DateTime @default(now())
  rewardClaimed   Boolean  @default(false)
  rewardClaimedAt DateTime?

  referral        Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@unique([referralId, milestoneMonths])
  @@map("referral_milestone_rewards")
}

// 포인트 거래 내역
model PointTransaction {
  id          String               @id @default(uuid())
  profileId   String
  amount      Int                  // 양수: 적립, 음수: 사용
  balance     Int                  // 거래 후 잔액

  type        PointTransactionType
  reason      String               // "추천 마일스톤: B님 3개월 구독 유지"
  referenceId String?              // 관련 ID (referralId, orderId 등)

  expiresAt   DateTime?            // 포인트 만료일 (12개월)
  createdAt   DateTime             @default(now())

  profile     Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt(sort: Desc)])
  @@map("point_transactions")
}

// ============================================================
// ENUMS
// ============================================================

enum ReferralStatus {
  ACTIVE      // 추천 관계 활성 (B가 구독 중)
  COMPLETED   // 모든 마일스톤 완료 (12개월 달성)
  CANCELLED   // B가 구독 취소
}

enum PointTransactionType {
  EARN_REFERRAL_MILESTONE  // 추천 마일스톤 보상
  EARN_AMBASSADOR          // 앰버서더 보상
  EARN_ORDER               // 주문 적립
  EARN_EVENT               // 이벤트 적립
  USE_ORDER                // 주문 사용
  EXPIRE                   // 만료
  ADMIN_ADJUST             // 관리자 조정
}

// 추천 마일스톤 유형 (피추천인 구독 유지 기간)
enum ReferralMilestoneType {
  REF_3M_RETENTION   // 3개월 유지: 3,000P
  REF_6M_RETENTION   // 6개월 유지: 5,000P
  REF_12M_RETENTION  // 12개월 유지: 10,000P (최종)
}

// 앰버서더 상태 유형
enum AmbassadorStatusType {
  CANDIDATE  // 후보 (추천 10명 미만)
  ACTIVE     // 활성 앰버서더 (10명 이상 추천 성공)
  INACTIVE   // 비활성 (자격 상실)
}

// ============================================================
// AMBASSADOR STATUS
// 10명 이상 추천 성공 시 앰버서더 자격 획득
// ============================================================

model AmbassadorStatus {
  id                  String               @id @default(uuid())
  profileId           String               @unique

  status              AmbassadorStatusType @default(CANDIDATE)
  qualifiedAt         DateTime?            // 앰버서더 자격 획득 일시
  totalReferrals      Int                  @default(0) // 총 추천 성공 수

  // 앰버서더 혜택 (JSON)
  // { "newProductPreview": true, "monthlyFreeShipping": 1 }
  benefits            Json                 @default("{}")

  // 다음 무료 배송 가능일 (월 1회)
  nextFreeShippingAt  DateTime?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  profile             Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("ambassador_statuses")
}

// ============================================================
// REFERRAL MILESTONE (Enum-based)
// 피추천인(B)의 구독 유지 기간에 따른 추천인(A) 보상 추적
// ============================================================

model ReferralMilestone {
  id              String                @id @default(uuid())
  referralId      String
  referrerId      String                // 추천인 (A) - 보상 받는 사람

  // 마일스톤 유형 (Enum)
  milestoneType   ReferralMilestoneType

  // 달성 정보
  achievedAt      DateTime              @default(now())
  rewardPoints    Int                   // 3000, 5000, 10000

  // 보상 수령 상태
  rewardClaimed   Boolean               @default(false)
  rewardClaimedAt DateTime?

  createdAt       DateTime              @default(now())

  // Relations
  referral        Referral              @relation("ReferralMilestones", fields: [referralId], references: [id], onDelete: Cascade)
  referrer        Profile               @relation("ReferrerMilestones", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referralId, milestoneType]) // 같은 추천에 대해 동일 마일스톤 중복 방지
  @@index([referrerId])
  @@index([referralId])
  @@map("referral_milestones")
}
