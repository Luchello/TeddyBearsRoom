  metadata            Json?               @default("{}")
  created_at          DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?           @default(now()) @db.Timestamptz(6)
  ts_products         ts_products?        @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ts_wholesalers      ts_wholesalers?     @relation(fields: [wholesaler_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
