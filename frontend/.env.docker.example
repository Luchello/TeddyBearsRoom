# Copy to .env.docker and edit values before first run

# Public app env (required)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
NEXT_PUBLIC_ENCRYPTION_SALT=tbr-dev-salt-2025

# PostgreSQL (compose DB defaults)
POSTGRES_DB=teddybears
POSTGRES_USER=tbr
POSTGRES_PASSWORD=tbr_password_change_me

# Prisma connection strings (app -> db service)
DATABASE_URL=postgresql://tbr:tbr_password_change_me@db:5432/teddybears?schema=public
DIRECT_URL=postgresql://tbr:tbr_password_change_me@db:5432/teddybears?schema=public

# Runtime controls
RUN_MIGRATIONS=true
SEED_ON_START=false
